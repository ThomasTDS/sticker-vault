<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Package visibility (Android 11+) to detect WhatsApp and WhatsApp Business. -->
  <queries>
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
  </queries>

  <application>
    <!-- Read by WhatsApp to load sticker packs; the permission is granted to WhatsApp only. -->
    <provider
      android:name="com.thomastds.whatsappstickers.StickerContentProvider"
      android:authorities="${applicationId}.stickercontentprovider"
      android:enabled="true"
      android:exported="true"
      android:readPermission="com.whatsapp.sticker.READ" />
  </application>
</manifest>
